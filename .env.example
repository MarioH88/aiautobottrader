# Alpaca Trading (required)
APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
# Paper (recommended): https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Optional override: ALPACA_PAPER=true|false

# Trading configuration (stocks and/or crypto, e.g. AAPL,BTC/USD)
TRADING_SYMBOLS=AAPL,TSLA
ORDER_QTY=1
STOP_LOSS_PCT=0.02
MAX_ALLOCATION_PCT=0.10
AUTO_START=true
ML_MODEL_TYPE=random_forest

# Phase 2 — WebSocket, news sentiment, ATR trailing stops
USE_WEBSOCKET=true
ENABLE_NEWS=true
USE_NEWS_WEBSOCKET=false
NEWS_POLL_INTERVAL_SEC=300
WS_RECONNECT_DELAY_SEC=120
ATR_PERIOD=14
ATR_MULTIPLIER=2.0
NEWS_LOOKBACK_MINUTES=30
TICK_INTERVAL_SEC=60
REST_FALLBACK_INTERVAL_SEC=120
MAX_RETRIES=5
RETRY_BASE_DELAY_SEC=1.0

# Macro sentiment + scheduler
ENABLE_MACRO_SENTIMENT=true
MACRO_SENTIMENT_CSV=macro_sentiment.csv
SENTIMENT_NEWS_WEIGHT=0.6
SCHEDULER_CONFIG_FILE=scheduler_config.json

# Optional notifications
DISCORD_WEBHOOK_URL=
