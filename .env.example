# Alpaca Trading (required)
APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
# Paper (recommended): https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Optional override: ALPACA_PAPER=true|false

# Trading configuration (stocks and/or crypto, e.g. AAPL,BTC/USD)
TRADING_SYMBOLS=AAPL,TSLA
ORDER_QTY=1
STOP_LOSS_PCT=0.02
MAX_ALLOCATION_PCT=0.10
AUTO_START=true
MAX_DAILY_BUYS=20

# Model + features (bar size must match between training and live)
ML_MODEL_TYPE=xgboost
BAR_TIMEFRAME_MIN=5
BAR_LIMIT=200
ALPACA_DATA_FEED=iex            # sip requires a paid Alpaca data plan
# Leave blank to use the threshold train_model.py recommends (stored in model.pkl)
MIN_SIGNAL_CONFIDENCE=

# Training data (build_training_data.py)
TRAIN_DATA_SOURCE=alpaca        # alpaca | yfinance (Yahoo caps 5m history at 60 days, 1h at 730)
TRAIN_LOOKBACK_DAYS=730
LABEL_HORIZON_BARS=6            # predict the move over the next 6 bars (30 min on 5m bars)
LABEL_ATR_MULT=0.5              # ...and call it up/down only if it exceeds 0.5 x ATR

# Sentiment
SENTIMENT_MODEL=finbert         # finbert | vader (falls back to vader if transformers/torch missing)
MACRO_SOURCE=fred               # fred | csv

# Phase 2 — WebSocket, news sentiment, ATR trailing stops
USE_WEBSOCKET=false
ENABLE_NEWS=true
USE_NEWS_WEBSOCKET=false
NEWS_POLL_INTERVAL_SEC=300
WS_RECONNECT_DELAY_SEC=120
ATR_PERIOD=14
ATR_MULTIPLIER=2.0
NEWS_LOOKBACK_MINUTES=30
TICK_INTERVAL_SEC=60
REST_FALLBACK_INTERVAL_SEC=120
MAX_RETRIES=5
RETRY_BASE_DELAY_SEC=1.0

# Macro sentiment + scheduler
ENABLE_MACRO_SENTIMENT=true
MACRO_SENTIMENT_CSV=macro_sentiment.csv
SENTIMENT_NEWS_WEIGHT=0.6
SCHEDULER_CONFIG_FILE=scheduler_config.json

# Optional notifications
DISCORD_WEBHOOK_URL=
